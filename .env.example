VITE_FIREBASE_API_KEY=replace_with_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=replace_with_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=replace_with_project_id
VITE_FIREBASE_STORAGE_BUCKET=replace_with_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=replace_with_sender_id
VITE_FIREBASE_APP_ID=replace_with_web_app_id
VITE_GEMINI_API_KEY=tu_api_key_aqui

# WhatsApp Business API (Secrets en Cloud Functions)
WHATSAPP_TOKEN=tu_whatsapp_token_aqui
WHATSAPP_PHONE_ID=tu_phone_id_aqui
WHATSAPP_BUSINESS_ID=tu_business_id_aqui
WHATSAPP_APP_SECRET=tu_app_secret_aqui
WA_VERIFY_TOKEN=tu_verify_token_aleatorio_aqui

# Piloto comercial: activar solo despues de aprobacion operativa y de seguridad
VITE_ENABLE_ADVANCED_WHATSAPP=false
VITE_ENABLE_AI_USAGE=false
VITE_ENABLE_CAMPAIGNS=false
VITE_ENABLE_MARKETING=false
VITE_ENABLE_MANUAL_CLINICAL_BACKUP=false
VITE_ENABLE_BROWSER_CLINICAL_MIGRATION=false

# Agenda operativa R6: mantener desactivada hasta validar staging y rollback
VITE_ENABLE_AGENDA_OPERATIONS_V2=false
VITE_PUBLIC_APP_URL=replace_with_public_app_url
