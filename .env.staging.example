# Copiar como .env.staging.local. Nunca versionar el archivo local con valores reales.
VITE_FIREBASE_API_KEY=replace_with_staging_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=replace_with_staging_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=replace_with_staging_project_id
VITE_FIREBASE_STORAGE_BUCKET=replace_with_staging_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=replace_with_staging_sender_id
VITE_FIREBASE_APP_ID=replace_with_staging_web_app_id

# El primer despliegue de staging parte con integraciones de riesgo deshabilitadas.
VITE_ENABLE_ADVANCED_WHATSAPP=false
VITE_ENABLE_AI_USAGE=false
VITE_ENABLE_CAMPAIGNS=false
VITE_ENABLE_MARKETING=false
VITE_ENABLE_MANUAL_CLINICAL_BACKUP=false
VITE_ENABLE_BROWSER_CLINICAL_MIGRATION=false
VITE_ENABLE_AGENDA_OPERATIONS_V2=false
VITE_PUBLIC_APP_URL=https://replace_with_staging_project_id.web.app
