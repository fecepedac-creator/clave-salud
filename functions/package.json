{
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "lint": "tsc --noEmit",
    "serve": "firebase emulators:start --only functions",
    "deploy": "npm run build && firebase deploy --only functions",
    "test:agent": "jest src/__tests__/whatsapp-agent.test.ts --runInBand",
    "test:integration": "jest --runInBand",
    "test:clinical:integration": "jest src/__tests__/clinical-draft-commands.integration.test.ts --runInBand",
    "test:patient-directory-integration": "jest --config jest.config.json src/__tests__/patient-directory.integration.test.ts --runInBand"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "date-fns": "^4.1.0",
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^7.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "eslint": "^9.14.0",
    "jest": "^30.3.0",
    "ts-jest": "^29.4.6",
    "typescript": "^5.6.3"
  }
}
